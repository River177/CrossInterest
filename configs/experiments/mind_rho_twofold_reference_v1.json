{
  "version": "mind-rho-twofold-reference-v1",
  "scope": "two class-balanced user-disjoint reference teachers and opposite-half scores; student training is a subsequent stage",
  "model_name": "Qwen/Qwen3.5-2B",
  "model_revision": "15852e8c16360a2fea060d615a32b45270f8a8fc",
  "initialization": "original pretrained weights and user-independent mean-norm SID initialization; no supervised parent adapter",
  "dataset": "data/training/mind_rho_twofold_v1",
  "folds": 2,
  "train_users_per_fold": 10800,
  "score_users_per_fold": 10800,
  "classes": 108,
  "users_per_class_per_fold": 100,
  "max_concurrent_gpus": 8,
  "gpus_per_teacher": 4,
  "optimizer_steps_per_teacher": 1014,
  "fixed_final_checkpoint": true,
  "evaluation_data_used_for_selection": false,
  "large_artifact_policy": "persistent remote storage only; independent verification on worker; compact JSON reports locally",
  "scoring": {
    "primary": "negative log-probability of first SID token over full effective vocabulary",
    "projection_dtype": "float32",
    "head_definition": "native effective tied PEFT output head including BF16-cast replacement rows promoted to FP32",
    "prior_adjustment": false,
    "diagnostics": ["108-way conditional SID NLL", "target logit", "full logsumexp", "108 SID scores", "rank"],
    "batch_size": 4,
    "shards": 4,
    "checkpoint_size": 256
  },
  "sft": {
    "seed": 42,
    "semantic_id_token_count": 108,
    "semantic_id_initialization_mode": "mean_norm_matched",
    "semantic_reload_reference_samples": 4,
    "enable_thinking": false,
    "max_seq_length": 2048,
    "epochs": 3,
    "per_device_train_batch_size": 1,
    "gradient_accumulation_steps": 8,
    "learning_rate": 0.00002,
    "weight_decay": 0.01,
    "warmup_ratio": 0.03,
    "lr_scheduler_type": "cosine",
    "max_grad_norm": 1.0,
    "gradient_checkpointing_use_reentrant": false,
    "lora_r": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.05,
    "target_modules": "all-linear",
    "optim": "adamw_torch_fused",
    "loss_reduction": "token_mean",
    "semantic_id_loss_scope": "full_vocabulary",
    "forbidden_trainable_module_substrings": ["vision", "visual"],
    "logging_steps": 1,
    "save_strategy": "steps",
    "save_steps": 100,
    "save_total_limit": 3,
    "persistent_checkpoint_limit": 3,
    "dataloader_num_workers": 2,
    "wandb_mode": "disabled"
  }
}
